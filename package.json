{
  "name": "@iki/patches",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "aube@2.11.0",
  "engines": {
    "bun": "1.4.5"
  },
  "scripts": {
    "check": "bun app/check.mjs",
    "step:check": "bun test --timeout 30000 test/catalog.test.mjs test/toolchain.test.mjs environments/install.test.mjs",
    "review:check": "bun test --timeout 30000 test/catalog.test.mjs test/toolchain.test.mjs environments/install.test.mjs",
    "environments:solve": "bun environments/install.mjs solve",
    "environments:setup": "bun environments/install.mjs setup",
    "test:package-bundles": "bun test/check-package-bundles.mjs",
    "check:package-bundles": "bun app/check-package-bundles.mjs"
  }
}
